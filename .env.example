# Copy to .env for local development. NEVER commit .env.
# All variables are prefixed TRADE_ and consumed by src/trade/config.py.

TRADE_ENVIRONMENT=local
TRADE_LOG_LEVEL=INFO
TRADE_LOG_FORMAT=console

# Read-only public data uses the production URL regardless of the testnet flag.
# The testnet URL is used only for signed endpoints and paper trading through Bybit testnet.
TRADE_USE_BYBIT_TESTNET=true

# Signed endpoints (leave unset until Phase 4). Bybit API keys must be:
#   - withdrawal-disabled
#   - IP-whitelisted
#   - rotated on the schedule in docs/V1_SPEC.md
# TRADE_BYBIT_API_KEY=
# TRADE_BYBIT_API_SECRET=

TRADE_PROMETHEUS_PORT=9464

# --- Paper-trading Telegram notifications (Phase 4c/4d) ---
# BOTH must be set for notifications to be delivered; otherwise the bot logs a
# "telegram_not_configured" warning at startup and runs with notifications
# disabled (a silent no-op). NEVER commit real values.
#   - Create a bot with @BotFather to get the token.
#   - Send your bot a message first, then get your chat id (e.g. via
#     https://api.telegram.org/bot<token>/getUpdates -> result[].message.chat.id).
# TRADE_TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
# TRADE_TELEGRAM_CHAT_ID=123456789
