# EnvironmentFile for trade-paper.service — copy to a secured path on the VPS,
# e.g. /etc/trade-paper.env  (chmod 600, owned by the service user).
# systemd services do NOT inherit your shell environment; the token/chat id
# MUST be provided here (or via Environment= lines) or notifications stay off.

TRADE_TELEGRAM_BOT_TOKEN=PUT-YOUR-BOT-TOKEN-HERE
TRADE_TELEGRAM_CHAT_ID=PUT-YOUR-CHAT-ID-HERE

# Optional: JSON logs are easier to grep in journalctl.
TRADE_LOG_FORMAT=json
TRADE_LOG_LEVEL=INFO
