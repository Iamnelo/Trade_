{
  "name": "family_ablation_eth_v1",
  "base_spec": {
    "name": "baseline_eth_5f_hourly_v1",
    "data": {
      "csv_path": "ETHUSDT_60_2y.csv",
      "symbol": "ETHUSDT",
      "interval": "60"
    },
    "features": [
      "log_return@5",
      "realized_vol@20",
      "atr@14",
      "macd_hist@12_26_9",
      "rsi_close@14"
    ],
    "label": {
      "kind": "triple_barrier",
      "horizon_bars": 6,
      "up_pct": 0.01,
      "down_pct": 0.01
    },
    "model": {
      "n_estimators": 100,
      "learning_rate": 0.05,
      "num_leaves": 15,
      "min_data_in_leaf": 5,
      "max_depth": -1,
      "calibration_fraction": 0.2
    },
    "strategy": {
      "confidence_threshold": 0.55,
      "notional_fraction": 0.5,
      "allow_short": true
    },
    "wfo": {
      "train_bars": 8640,
      "test_bars": 1440,
      "step_bars": 1440,
      "expanding": false
    },
    "backtest": {
      "initial_equity": 10000.0,
      "fee_bps": 5.5,
      "slippage_bps": 5.0,
      "bars_per_year": 8760
    },
    "gates": {
      "max_fold_drawdown_pct": 15.0,
      "min_pct_folds_positive_cas": 0.5,
      "min_fills_per_fold": 0,
      "min_folds_with_trades": 3,
      "max_annualized_turnover": 50.0
    }
  },
  "variants": [
    {
      "name": "add_time_cyclic",
      "add_features": [
        "time_of_day@sin",
        "time_of_day@cos",
        "day_of_week@sin",
        "day_of_week@cos"
      ],
      "description": "Intraday + weekly seasonality via sin/cos encoding."
    },
    {
      "name": "add_higher_order",
      "add_features": [
        "return_skew@20",
        "return_kurtosis@20"
      ],
      "description": "Third + fourth standardised moments of log returns."
    },
    {
      "name": "add_volume_liquidity",
      "add_features": [
        "volume_zscore@48",
        "turnover_zscore@48"
      ],
      "description": "48h rolling z-scores of bar volume and turnover."
    },
    {
      "name": "add_vol_regime",
      "add_features": [
        "vol_regime@20_120"
      ],
      "description": "log(short_vol/long_vol) \u2014 hot/cold regime indicator."
    }
  ]
}